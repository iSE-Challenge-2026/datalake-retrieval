# Required when parsing raw images/documents through Lift API.
DATALAB_API_KEY=

# Required for OpenRouter embeddings, ASR, enrichment, or LLM reranking.
OPENROUTER_API_KEY=
# Optional OpenRouter attribution headers.
OPENROUTER_HTTP_REFERER=

# OpenRouter model defaults.
# OPENROUTER_MODEL is the fallback chat model for ad hoc reasoning.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Role-specific model names for future routing.
OPENROUTER_REASONING_MODEL=google/gemini-2.5-flash
OPENROUTER_RERANK_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_TABLE_DESCRIPTION_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_ASR_MODEL=openai/whisper-large-v3
OPENROUTER_ASR_LANGUAGE=
